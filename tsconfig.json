{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "engine",
    "effects",
    "styles",
    "media",
    "server",
    "app",
    "tests",
    "cli.ts",
    "reels/tools",
    "reels/review",
    "reels/tests"
  ]
}
